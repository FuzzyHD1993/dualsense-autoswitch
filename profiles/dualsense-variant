#!/usr/bin/env bash
# Диспетчер профилей DualSense. Имя варианта = имя файла dualsense-profile-<variant>.
#
# Каждый профиль — свой тактильный «характер»:
#   feedback  — сопротивление с позиции
#   weapon    — свободный ход + жёсткий упор (спуск)
#   bow       — натяжение + срыв (тетива)
#   machine   — пульсирующее сопротивление (авто-атака)
#   slope_*   — плавно нарастающее сопротивление (педаль/замах)
#   vibration — жужжание под пальцем при зажатии
#   vibration-raw — «сформированное» жужжание по глубине хода
set -u
self=$(basename "$0")
variant="${self#dualsense-profile-}"

if ! dualsensectl -l 2>/dev/null | grep -q "("; then
    echo "DualSense не найден" >&2
    exit 0
fi

apply() { dualsensectl trigger right "$@"; }
left()  { dualsensectl trigger left "$@"; }

case "$variant" in
  # --- Alan Wake 2: револьвер + наведение с лёгким жужжанием ---
  aw2)
      apply weapon 2 6 8
      left  vibration 1 4 22
      dualsensectl lightbar 180 20 20 120 ;;
  aw2-bow)
      apply bow 2 9 7 6
      left  vibration 2 3 18
      dualsensectl lightbar 160 40 20 120 ;;
  aw2-shotgun)
      apply weapon 1 8 8
      left  feedback 5 4
      dualsensectl lightbar 120 10 10 120 ;;

  # --- RDR2: тяжёлый револьвер + «дед-ай» гул под пальцем ---
  rdr2)
      apply weapon 1 7 8
      left  vibration-raw 0 0 1 2 3 5 6 6 4 2 16
      dualsensectl lightbar 200 120 40 120 ;;
  rdr2-bow)
      apply bow 2 8 6 5
      left  vibration 1 3 18
      dualsensectl lightbar 200 90 30 120 ;;

  # --- PoE2: ритм авто-атаки + сильное жужжание на утилите ---
  poe2)
      apply machine 2 8 6 8 20 10
      left  vibration 1 6 35
      dualsensectl lightbar 120 40 200 120 ;;
  poe2-bow)
      apply bow 2 8 6 5
      left  vibration 1 4 25
      dualsensectl lightbar 100 30 180 120 ;;

  # --- Crimson Desert: вес меча + блок с вибрацией ---
  cd)
      apply slope_feedback 1 8 7
      left  vibration 2 3 15
      dualsensectl lightbar 200 20 30 120 ;;

  # --- Euro Truck: педаль газа + твёрдый тормоз ---
  ets2)
      apply slope_feedback 1 9 8
      left  weapon 1 9 8
      dualsensectl lightbar 40 160 200 120 ;;

  # --- Cyberpunk 2077: короткий спуск + наведение с гулом ---
  cp2077)
      apply weapon 1 7 8
      left  vibration 1 4 20
      dualsensectl lightbar 250 220 40 120 ;;

  # --- нейтраль ---
  default)
      dualsensectl trigger both off
      dualsensectl lightbar 0 0 255
      dualsensectl player-leds 0
      dualsensectl microphone-led off
      echo "профиль default"
      exit 0 ;;
  *)
      echo "неизвестный вариант: $variant" >&2
      exit 1 ;;
esac

dualsensectl player-leds 1 2>/dev/null || true
dualsensectl microphone-led off 2>/dev/null || true
echo "профиль $variant применён"
